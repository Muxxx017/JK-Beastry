<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_animal_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/daily_animal_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/daily_animal_photo"
        android:layout_width="96dp"
        android:layout_height="112dp"
        android:background="#E7ECE5"
        android:contentDescription="@string/daily_animal_photo_description"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/daily_animal_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/daily_animal_title"
            android:textColor="#24372B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_animal_scientific_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#526256"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/daily_animal_fact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="#344339"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/daily_animal_photo_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#68756A"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
